# --- Dependencies & build output ---
node_modules/
dist/
build/
.wrangler/

# --- Environment & secrets ---
# Never commit real credentials. Only *.example files are tracked.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
*.local
secrets.json

# --- Android: keystores, signing, and local config ---
# local.properties contains absolute SDK paths; keystores sign your releases.
local.properties
*.keystore
*.jks
keystore.properties
google-services.json
.gradle/
captures/
*.apk
*.aab
app/release/

# --- iOS / Xcode ---
# MatchCraft.xcodeproj is generated by XcodeGen from project.yml — not tracked.
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
Pods/
*.mobileprovision
*.p12
*.cer

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.idea/
*.swp
