<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MatchCraft" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/brand_rose</item>
        <item name="colorPrimaryVariant">@color/brand_pink</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/brand_orange</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <style name="Theme.MatchCraft.NoActionBar" parent="Theme.MatchCraft">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
